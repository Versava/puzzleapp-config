{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puzzle.versava.net/manifest.schema.json",
  "title": "PuzzleApp generator schedule",
  "description": "Semantic validation requires contiguous base coverage and immutable published assignments. Optional selections or legacy additions windows are ordered, nonoverlapping, within base coverage, and mutually exclusive on each date.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "datePolicy",
    "validThrough",
    "windows",
    "updates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "datePolicy": {
      "const": "device-local"
    },
    "validThrough": {
      "type": "string",
      "format": "date",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "through",
          "edition",
          "minBuild"
        ],
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "through": {
            "type": "string",
            "format": "date",
            "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "edition": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "minBuild": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ios",
              "android"
            ],
            "properties": {
              "ios": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "android": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            }
          }
        }
      }
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ios",
        "android"
      ],
      "properties": {
        "ios": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2048,
              "pattern": "^https://(?:apps\\.apple\\.com(?::443)?(?:[/?#]|$)|testflight\\.apple\\.com(?::443)?/join/[a-zA-Z0-9]{8}$)"
            }
          }
        },
        "android": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2048,
              "pattern": "^https://play\\.google\\.com(?::443)?(?:[/?#]|$)"
            }
          }
        }
      }
    },
    "additions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "through",
          "edition",
          "minBuild"
        ],
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "through": {
            "type": "string",
            "format": "date",
            "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "edition": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "minBuild": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ios",
              "android"
            ],
            "properties": {
              "ios": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "android": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            }
          }
        }
      }
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "through",
          "edition",
          "minBuild"
        ],
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "through": {
            "type": "string",
            "format": "date",
            "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "edition": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "minBuild": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ios",
              "android"
            ],
            "properties": {
              "ios": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "android": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            }
          }
        }
      }
    }
  }
}
